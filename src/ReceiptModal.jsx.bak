import { useState } from "react";

function ReceiptModal({ booking: initialBooking, isOpen, onClose, onCancelBooking }) {
  const [booking, setBooking] = useState(initialBooking);
  const [activeTab, setActiveTab] = useState("receipt"); 
  const [emailSentToast, setEmailSentToast] = useState(false);
  const [cancelToast, setCancelToast] = useState(false);
  const [contactAdminAlert, setContactAdminAlert] = useState(false);

  if (!isOpen || !booking) return null;

  
  const checkWithin24Hours = () => {
    let createdMs = booking.createdAtMs;
    if (!createdMs && booking.dateCreated) {
      createdMs = new Date(booking.dateCreated).getTime();
    }
    if (!createdMs || isNaN(createdMs)) return true; 

    const elapsedMs = Date.now() - createdMs;
    const elapsedHours = elapsedMs / (1000 * 60 * 60);
    return elapsedHours <= 24;
  };

  const canSelfCancel = checkWithin24Hours();


  const pricePerNight =
    booking.pricePerNight ||
    (booking.roomId === "villa" ? 3500 : booking.roomId === "kubo" ? 2200 : 3000);

  const calculateNights = () => {
    if (booking.nights) return booking.nights;
    if (booking.checkIn && booking.checkOut) {
      const start = new Date(booking.checkIn);
      const end = new Date(booking.checkOut);
      if (!isNaN(start) && !isNaN(end) && end > start) {
        return Math.ceil((end - start) / (1000 * 60 * 60 * 24));
      }
    }
    return 1;
  };

  const nights = calculateNights();
  const guestCount = Math.max(1, Number(booking.guests) || 1);
  const extraGuests = Math.max(0, guestCount - 2); 
  const extraGuestRate = booking.roomId === "villa" ? 500 : 300;
  const extraGuestNightlyFee = extraGuests * extraGuestRate;

  const roomBaseSubtotal = pricePerNight * nights;
  const extraGuestSubtotal = extraGuestNightlyFee * nights;
  const subtotal = roomBaseSubtotal + extraGuestSubtotal;
  const vatIncluded = Math.round(subtotal * 0.12);
  const formattedTotal = `â‚±${subtotal.toLocaleString()}`;
  const receiptNo = booking.receiptNo || `RCP-${booking.id || "BK-000000"}`;
  const dateIssued = booking.dateCreated || new Date().toISOString().split("T")[0];

  const handlePrint = () => {
    window.print();
  };

  const handleResendEmail = () => {
    setEmailSentToast(true);
    setTimeout(() => {
      setEmailSentToast(false);
    }, 3000);
  };

  const handleCancelReservation = () => {
    if (!canSelfCancel) {
      setContactAdminAlert(true);
      return;
    }

    if (window.confirm(`Are you sure you want to cancel booking reference ${booking.id}?`)) {
      const updatedBooking = { ...booking, status: "Cancelled" };
      setBooking(updatedBooking);

      
      try {
        const savedBookings = JSON.parse(localStorage.getItem("casa_bookings") || "[]");
        const newBookings = savedBookings.map((b) =>
          b.id === booking.id ? { ...b, status: "Cancelled" } : b
        );
        localStorage.setItem("casa_bookings", JSON.stringify(newBookings));
      } catch (err) {
        console.error("Error updating booking status:", err);
      }

      if (onCancelBooking) {
        onCancelBooking(booking.id);
      }

      setCancelToast(true);
      setTimeout(() => {
        setCancelToast(false);
      }, 4000);
    }
  };

  return (
    <div
      className="modal show d-block"
      tabIndex="-1"
      style={{ backgroundColor: "rgba(0,0,0,0.65)", zIndex: 1060 }}
    >
      <style>{`
        @media print {
          body * {
            visibility: hidden;
          }
          .printable-receipt, .printable-receipt * {
            visibility: visible;
          }
          .printable-receipt {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 20px;
            box-shadow: none !important;
            border: none !important;
          }
          .no-print {
            display: none !important;
          }
        }
      `}</style>

      <div className="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div className="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
          
          <div
            className="modal-header border-0 text-white p-4 no-print"
            style={{ backgroundColor: "#2f4a3c" }}
          >
            <div className="d-flex align-items-center gap-3">
              <span className="fs-3">ðŸ§¾</span>
              <div>
                <h5 className="modal-title fw-bold mb-0" style={{ fontFamily: "'Playfair Display', serif" }}>
                  Booking Receipt & Confirmation
                </h5>
                <small className="opacity-75">Reference: {booking.id}</small>
              </div>
            </div>
            <button
              type="button"
              className="btn-close btn-close-white"
              onClick={onClose}
            ></button>
          </div>

          
          <div className="bg-light border-bottom px-4 pt-3 no-print">
            <ul className="nav nav-tabs border-0 gap-2">
              <li className="nav-item">
                <button
                  className={`nav-link fw-semibold border-0 rounded-top-3 px-4 py-2 ${
                    activeTab === "receipt"
                      ? "active bg-white text-success border-top border-start border-end"
                      : "text-secondary"
                  }`}
                  onClick={() => setActiveTab("receipt")}
                >
                  ðŸ§¾ Official Receipt
                </button>
              </li>
              <li className="nav-item">
                <button
                  className={`nav-link fw-semibold border-0 rounded-top-3 px-4 py-2 ${
                    activeTab === "email"
                      ? "active bg-white text-success border-top border-start border-end"
                      : "text-secondary"
                  }`}
                  onClick={() => setActiveTab("email")}
                >
                  âœ‰ï¸ Email Confirmation
                </button>
              </li>
            </ul>
          </div>

        
          <div className="modal-body p-4 bg-light">
            {emailSentToast && (
              <div className="alert alert-success d-flex align-items-center justify-content-between mb-4 shadow-sm no-print">
                <div>
                  âœ“ <strong>Email Sent!</strong> A copy of this receipt has been dispatched to <u>{booking.email}</u>.
                </div>
                <button
                  type="button"
                  className="btn-close ms-2"
                  onClick={() => setEmailSentToast(false)}
                ></button>
              </div>
            )}

            {cancelToast && (
              <div className="alert alert-warning d-flex align-items-center justify-content-between mb-4 shadow-sm no-print">
                <div>
                  ðŸš« <strong>Reservation Cancelled!</strong> Booking Reference <u>{booking.id}</u> has been marked as Cancelled.
                </div>
                <button
                  type="button"
                  className="btn-close ms-2"
                  onClick={() => setCancelToast(false)}
                ></button>
              </div>
            )}

            {contactAdminAlert && (
              <div className="alert alert-danger mb-4 shadow-sm no-print">
                <div className="fw-bold mb-1">ðŸ”’ 24-Hour Self-Cancellation Period Expired</div>
                <p className="small mb-2">
                  As per hotel policy, bookings can only be self-cancelled within 24 hours of creation. Since 24 hours have passed, please contact the Admin directly to request cancellation.
                </p>
                <div className="small fw-bold border-top pt-2">
                  ðŸ“ž Phone: +63 (0912) 345-6789 | âœ‰ï¸ Email: reservations@casagracia.com
                </div>
              </div>
            )}

            
            {activeTab === "receipt" && (
              <div className="printable-receipt bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                
                <div className="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center border-bottom pb-4 mb-4 gap-3">
                  <div>
                    <h3 className="fw-bold mb-1" style={{ fontFamily: "'Playfair Display', serif", color: "#2f4a3c" }}>
                      Casa Gracia's Hotel & Resort
                    </h3>
                    <p className="small text-muted mb-0">
                      Beachfront Paradise & Luxury Cottages
                    </p>
                    <p className="small text-muted mb-0">Contact: reservations@casagracia.com | +63 (0912) 345-6789</p>
                  </div>
                  <div className="text-sm-end">
                    <span className="badge px-3 py-2 fs-6 rounded-pill mb-2" style={{ backgroundColor: "#2f4a3c", color: "#fff" }}>
                      OFFICIAL RECEIPT
                    </span>
                    <div className="small font-monospace text-muted"><strong>Receipt No:</strong> {receiptNo}</div>
                    <div className="small text-muted"><strong>Date Issued:</strong> {dateIssued}</div>
                  </div>
                </div>

                
                <div
                  className={`p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center ${
                    booking.status === "Confirmed"
                      ? "bg-success-subtle text-success border border-success"
                      : booking.status === "Cancelled"
                      ? "bg-danger-subtle text-danger border border-danger"
                      : "bg-warning-subtle text-dark border border-warning"
                  }`}
                >
                  <div>
                    <span className="fw-bold">Booking Status: </span>
                    <span className="text-uppercase fw-bold">{booking.status || "Pending"}</span>
                  </div>
                  <span className="small">Ref: {booking.id}</span>
                </div>

                
                <div className="row g-4 mb-4">
                  <div className="col-md-6">
                    <div className="p-3 rounded-3 bg-light border h-100">
                      <h6 className="fw-bold text-uppercase small text-muted mb-2">Booker Information</h6>
                      <div className="fw-bold text-dark fs-6">{booking.fullName}</div>
                      <div className="text-muted small">{booking.email}</div>
                      <div className="text-muted small mt-1">Guests Registered: <strong>{guestCount} Person(s)</strong></div>
                    </div>
                  </div>
                  <div className="col-md-6">
                    <div className="p-3 rounded-3 bg-light border h-100">
                      <h6 className="fw-bold text-uppercase small text-muted mb-2">Reservation Details</h6>
                      <div className="fw-bold text-dark fs-6">{booking.roomName}</div>
                      <div className="text-muted small">Check-in: <strong>{booking.checkIn}</strong> (2:00 PM)</div>
                      <div className="text-muted small">Check-out: <strong>{booking.checkOut}</strong> (12:00 PM)</div>
                      <div className="text-muted small">Stay Duration: <strong>{nights} Night(s)</strong></div>
                    </div>
                  </div>
                </div>

                
                <div className="table-responsive mb-4">
                  <table className="table table-bordered align-middle">
                    <thead className="table-light">
                      <tr className="small text-uppercase text-muted">
                        <th>Description</th>
                        <th className="text-center">Rate / Night</th>
                        <th className="text-center">Duration</th>
                        <th className="text-end">Amount</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>
                          <div className="fw-bold text-dark">{booking.roomName}</div>
                          <small className="text-muted">Standard Room Base Accommodation (Base 2 Guests Included)</small>
                        </td>
                        <td className="text-center font-monospace">â‚±{pricePerNight.toLocaleString()}</td>
                        <td className="text-center font-monospace">{nights} Night(s)</td>
                        <td className="text-end font-monospace fw-bold">â‚±{roomBaseSubtotal.toLocaleString()}</td>
                      </tr>
                      {extraGuests > 0 && (
                        <tr>
                          <td>
                            <div className="fw-bold text-dark">Extra Guest Charges</div>
                            <small className="text-muted">
                              {extraGuests} Extra Guest(s) @ â‚±{extraGuestRate.toLocaleString()}/night
                            </small>
                          </td>
                          <td className="text-center font-monospace">â‚±{extraGuestNightlyFee.toLocaleString()}</td>
                          <td className="text-center font-monospace">{nights} Night(s)</td>
                          <td className="text-end font-monospace fw-bold">â‚±{extraGuestSubtotal.toLocaleString()}</td>
                        </tr>
                      )}
                    </tbody>
                    <tfoot>
                      <tr>
                        <td colSpan="3" className="text-end fw-semibold text-muted small">Subtotal</td>
                        <td className="text-end font-monospace fw-semibold">â‚±{subtotal.toLocaleString()}</td>
                      </tr>
                      <tr>
                        <td colSpan="3" className="text-end text-muted small">12% VAT (Included in price)</td>
                        <td className="text-end font-monospace text-muted small">â‚±{vatIncluded.toLocaleString()}</td>
                      </tr>
                      <tr className="table-active">
                        <td colSpan="3" className="text-end fw-bold fs-5" style={{ color: "#2f4a3c" }}>Total Booking Cost</td>
                        <td className="text-end font-monospace fw-bold fs-5" style={{ color: "#2f4a3c" }}>
                          {formattedTotal}
                        </td>
                      </tr>
                    </tfoot>
                  </table>
                </div>

                
                <div className="p-3 bg-light rounded-3 border mb-2 small text-muted">
                  <div className="fw-bold text-dark mb-1">ðŸ“Œ Cancellation & Check-in Policy:</div>
                  <ul className="mb-0 ps-3">
                    <li>Self-cancellation is allowed within <strong>24 hours</strong> of booking creation.</li>
                    <li>If more than 24 hours have passed, please contact Casa Gracia Admin directly for cancellations.</li>
                    <li>Standard check-in time is at 2:00 PM; check-out time is at 12:00 PM.</li>
                  </ul>
                </div>
              </div>
            )}

            
            {activeTab === "email" && (
              <div className="bg-white rounded-4 shadow-sm border overflow-hidden">
                
                <div className="bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                  <div className="d-flex align-items-center gap-2">
                    <span className="badge bg-secondary">INBOX</span>
                    <span className="small text-truncate" style={{ maxWidth: "350px" }}>
                      Subject: Booking Confirmation & Receipt - Casa Gracia's Hotel ({booking.id})
                    </span>
                  </div>
                  <button
                    onClick={handleResendEmail}
                    className="btn btn-sm btn-outline-light rounded-pill px-3 no-print"
                  >
                    âœ‰ï¸ Resend Email
                  </button>
                </div>

                
                <div className="p-3 bg-light border-bottom small">
                  <div className="row g-2">
                    <div className="col-auto text-muted">From:</div>
                    <div className="col fw-bold text-dark">Casa Gracia Reservations &lt;reservations@casagracia.com&gt;</div>
                  </div>
                  <div className="row g-2 mt-1">
                    <div className="col-auto text-muted">To:</div>
                    <div className="col font-monospace text-primary">{booking.email}</div>
                  </div>
                  <div className="row g-2 mt-1">
                    <div className="col-auto text-muted">Date:</div>
                    <div className="col text-muted">{new Date().toLocaleString()}</div>
                  </div>
                </div>

                
                <div className="p-4 p-md-5">
                  <div className="text-center pb-4 mb-4 border-bottom">
                    <div className="display-6 fw-bold mb-1" style={{ fontFamily: "'Playfair Display', serif", color: "#2f4a3c" }}>
                      Casa Gracia's Hotel
                    </div>
                    <p className={booking.status === "Cancelled" ? "text-danger fw-semibold mb-0" : "text-success fw-semibold mb-0"}>
                      {booking.status === "Cancelled" ? "ðŸš« Reservation Status: CANCELLED" : "âœ“ Booking Request Confirmed & Received"}
                    </p>
                  </div>

                  <p className="fs-6 mb-3">Dear <strong>{booking.fullName}</strong>,</p>
                  <p className="text-muted mb-4">
                    {booking.status === "Cancelled"
                      ? "Your booking reservation request has been officially cancelled. If you did not request this cancellation or wish to re-book, please contact us."
                      : "Thank you for choosing Casa Gracia's Hotel! We are pleased to confirm that we have received your reservation request. Below are your booking breakdown details and official receipt."}
                  </p>

                  
                  <div className="card border-0 bg-light rounded-4 p-4 mb-4">
                    <h5 className="fw-bold mb-3" style={{ color: "#2f4a3c" }}>Booking Cost & Receipt Summary</h5>
                    <div className="row g-3 small">
                      <div className="col-6 col-sm-3">
                        <span className="text-muted d-block">Booking Reference</span>
                        <strong className="font-monospace fs-6">{booking.id}</strong>
                      </div>
                      <div className="col-6 col-sm-3">
                        <span className="text-muted d-block">Receipt No.</span>
                        <strong className="font-monospace fs-6">{receiptNo}</strong>
                      </div>
                      <div className="col-6 col-sm-3">
                        <span className="text-muted d-block">Selected Accommodation</span>
                        <strong>{booking.roomName}</strong>
                      </div>
                      <div className="col-6 col-sm-3">
                        <span className="text-muted d-block">Total Guests</span>
                        <strong>{guestCount} Guest(s)</strong>
                      </div>
                    </div>

                    <hr className="my-3 text-muted" />

                    <div className="d-flex justify-content-between align-items-center mb-2">
                      <span className="text-muted">Check-in Date:</span>
                      <strong className="text-dark">{booking.checkIn} (from 2:00 PM)</strong>
                    </div>
                    <div className="d-flex justify-content-between align-items-center mb-2">
                      <span className="text-muted">Check-out Date:</span>
                      <strong className="text-dark">{booking.checkOut} (until 12:00 PM)</strong>
                    </div>
                    <div className="d-flex justify-content-between align-items-center mb-2">
                      <span className="text-muted">Stay Duration:</span>
                      <strong>{nights} Night(s)</strong>
                    </div>
                    {extraGuests > 0 && (
                      <div className="d-flex justify-content-between align-items-center mb-2">
                        <span className="text-muted">Extra Guest Fee:</span>
                        <strong>{extraGuests} Guest(s) @ â‚±{extraGuestRate}/night</strong>
                      </div>
                    )}
                    <div className="d-flex justify-content-between align-items-center pt-2 border-top">
                      <span className="fw-bold fs-5 text-dark">Total Booking Cost:</span>
                      <span className="fw-bold fs-4 text-success font-monospace">{formattedTotal}</span>
                    </div>
                  </div>

                  <p className="small text-muted mb-4">
                    Self-cancellation is available within 24 hours of booking. After 24 hours, please contact Casa Gracia Admin directly to request cancellation.
                  </p>

                  <div className="text-center pt-3 border-top text-muted small">
                    Casa Gracia's Hotel & Resort â€¢ All Rights Reserved.
                  </div>
                </div>
              </div>
            )}
          </div>

          
          <div className="modal-footer border-0 bg-white px-4 py-3 justify-content-between no-print">
            <div>
              {booking.status === "Cancelled" ? (
                <span className="badge bg-danger rounded-pill px-3 py-2">
                  Reservation Cancelled
                </span>
              ) : canSelfCancel ? (
                <button
                  type="button"
                  className="btn btn-outline-danger rounded-pill px-4"
                  onClick={handleCancelReservation}
                >
                  ðŸš« Cancel Booking (Self-Cancel &lt;24h)
                </button>
              ) : (
                <button
                  type="button"
                  className="btn btn-outline-secondary rounded-pill px-3"
                  onClick={() => setContactAdminAlert(true)}
                  title="24h cancellation period expired"
                >
                  ðŸ”’ Contact Admin to Cancel (&gt;24h)
                </button>
              )}
            </div>

            <div className="d-flex gap-2">
              <button
                type="button"
                className="btn btn-outline-secondary rounded-pill px-4"
                onClick={onClose}
              >
                Close
              </button>
              <button
                type="button"
                className="btn btn-outline-success rounded-pill px-4"
                onClick={handleResendEmail}
              >
                âœ‰ï¸ Send to Email
              </button>
              <button
                type="button"
                className="btn text-white rounded-pill px-4 fw-bold"
                style={{ backgroundColor: "#2f4a3c" }}
                onClick={handlePrint}
              >
                ðŸ–¨ï¸ Print / Download Receipt
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

export default ReceiptModal;

